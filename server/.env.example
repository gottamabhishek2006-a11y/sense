# CivicFix Server Environment Template (Copy to .env)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/civicsense?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://civic-sense-chi.vercel.app
NODE_ENV=production

# Admin account (set before running npm run seed:admin)
# Never expose in frontend code or API responses
ADMIN_EMAIL=admin@yourdomain.gov
ADMIN_PASSWORD=YourStrongAdminPassword@2026!
ADMIN_NAME=Municipal Administrator
